{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fixline-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/health"]
  },

  "vars": {
    "FIXLINE_LOCATION_ID": "loc-seattle-king-county-wa-us",
    "FIXLINE_MODE": "bounded-demo"
  },

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "31add96f58c9465fa622461292b01838"
    }
  ]
}
